# Copy to .env and fill in. All values are optional except DB_PASSWORD (has a default).
# docker compose -f deploy/docker-compose.yml --env-file deploy/.env up --build

# Postgres password (defaults to "apiguard" if unset).
DB_PASSWORD=apiguard

# Host port for the app (dashboard + API are the same origin). Default 8080.
APIGUARD_PORT=8080

# Shared API key every caller must send. Strongly recommended for any instance reachable by more
# than you: without it, anyone who can reach the port can read the estate and start syncs.
# Testers paste it once via the key button in the dashboard sidebar. e.g. openssl rand -hex 32
APIGUARD_API_KEY_SERVER=

# Encryption key for the saved Anypoint secret (AES-GCM at rest). Set a long random value so the
# connection survives container restarts; keep it stable and back it up. Blank = creds stay in memory
# (you'd re-connect Anypoint after each restart). Generate one, e.g.:  openssl rand -base64 32
APIGUARD_ENCRYPTION_KEY=

# GitHub PAT with repo + pull_requests scope — enables PR comments, reviewer requests, spec fetch.
# Leave blank to run the server in "log only" mode (it prints what it would do).
GITHUB_TOKEN=

# Shared secret configured on the GitHub webhook (HMAC verification). Blank = /webhooks/github
# rejects every payload (set GITHUB_WEBHOOK_ALLOW_UNSIGNED=true only for a local experiment).
GITHUB_WEBHOOK_SECRET=

# Slack Incoming Webhook URL for breaking-change notifications. Blank = disabled.
SLACK_WEBHOOK_URL=

# For webhook mode: which spec file to diff on each PR, and the API name for blast-radius matching.
APIGUARD_WEBHOOK_SPEC_PATH=openapi.yaml
APIGUARD_WEBHOOK_API_NAME=orders-api
